import os
import requests
from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer
from dotenv import load_dotenv

load_dotenv()

class TradingBot:
    def __init__(self):
        self.news_api_key = os.getenv("f47b85db22664beba249feed052403c3")
        self.analyzer = SentimentIntensityAnalyzer()

    def get_sentiment(self, asset_name):
        """Cerca le ultime notizie e restituisce un punteggio da -1 a 1"""
        url = f"https://newsapi.org/v2/everything?q={asset_name}&apiKey={self.news_api_key}&language=en"
        response = requests.get(url).json()
        articles = response.get('articles', [])[:5]
        
        if not articles: return 0
        
        scores = []
        for art in articles:
            text = (art['title'] or "") + " " + (art['description'] or "")
            scores.append(self.analyzer.polarity_scores(text)['compound'])
        
        return sum(scores) / len(scores)

